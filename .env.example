# Newsletter (Supabase) — painel do projeto > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo usado pelo endpoint DELETE /api/newsletter-delete (exclusão de
# dados a pedido do titular, LGPD Art. 18). Gere uma string aleatória
# qualquer, por exemplo: openssl rand -hex 32
ADMIN_DELETE_SECRET=

# E-mail de confirmação de cadastro (Resend) — resend.com > API Keys
RESEND_API_KEY=
# Opcional: só preencher depois de verificar seu domínio no Resend.
# Enquanto vazio, usa o remetente de teste onboarding@resend.dev
RESEND_FROM_EMAIL=

# Pixel de Conversão do Meta (Facebook/Instagram Ads) — Gerenciador de
# Eventos > Origens de dados > seu pixel. É um valor público (aparece no
# código-fonte da página), não precisa ser secreto.
NEXT_PUBLIC_META_PIXEL_ID=
